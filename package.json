{
  "name": "contatos-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:comentarios": "! git grep --untracked -nE '(^|\\s)(#|--|//|/\\*)(\\s|$)' -- '*.sql' '*.sh' '*.yml' '*.yaml' '.env.example' 'tsconfig*.json' '.prettierrc.json'",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/http",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "gate": "npm run typecheck && npm run lint && npm run lint:comentarios && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
